# Copia este archivo como .env.local (desarrollo) o .env (servidor) y completa los valores.
# Nunca subas el archivo con valores reales al repositorio.
# Para generar un secreto:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- IA ---
# Clave de API de Groq (obligatoria). Se obtiene en https://console.groq.com/keys
# También se acepta el nombre AI_API_KEY.
GROQ_API_KEY=
# Modelo de Groq (opcional). Por defecto: openai/gpt-oss-120b
GROQ_MODEL=

# --- Base de datos (PostgreSQL 16) ---
# Usuario de la aplicación (miembro del rol landing_ia_app, sin permisos de estructura).
DATABASE_URL=postgres://landing_ia:desarrollo-local@127.0.0.1:5433/landing_ia
# Usuario dueño del esquema, solo para migraciones y la tarea de retención (opcional; si falta se usa DATABASE_URL).
DATABASE_MIGRATION_URL=

# --- Secretos (mínimo 32 caracteres cada uno; distintos entre sí) ---
# Firma de los tokens de acceso. Rotar cada 90 días: mover el valor actual a AUTH_SECRET_PREVIOUS.
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
# Cifra los secretos de verificación en dos pasos. Si se pierde, el personal debe reconfigurar su app.
DATA_ENCRYPTION_KEY=
# "Pimienta" de las contraseñas: se guarda fuera de la base de datos. Si cambia, nadie podrá iniciar sesión.
PASSWORD_PEPPER=

# --- Correo ---
# URL pública de la app, para los enlaces de los correos.
APP_URL=http://localhost:3000
# Servidor SMTP (obligatorio en producción), p. ej. smtps://usuario:clave@smtp.proveedor.com:465
# Sin él, en desarrollo los correos se guardan en <DATA_DIR>/outbox.
SMTP_URL=
MAIL_FROM=Landing IA <no-responder@tu-dominio.com>

# --- Almacenamiento ---
# Carpeta de imágenes subidas (opcional). Por defecto: ./data. En el servidor, un volumen persistente.
DATA_DIR=

# --- Límites y acceso (opcionales) ---
# Solicitudes por minuto por IP a toda la API. Por defecto: 60
API_RATE_LIMIT_PER_MINUTE=
# Landings nuevas por cuenta (o por IP sin sesión) al día. Por defecto: 3 en producción, sin límite en desarrollo. 0 = sin límite.
AI_DAILY_GENERATIONS=
# Imágenes subidas por IP al día. Por defecto: 50
UPLOADS_PER_DAY=
# IP desde las que se permite el panel de administración, separadas por comas. Vacío = cualquiera.
ADMIN_ALLOWED_IPS=
